# Set only for local API development. This is rejected in Cloud Run.
PORT=8787
# Opt in to the local in-memory demo roster. NODE_ENV alone never enables it.
# LGS_TEST_MODE=demo
#
# `npm run test:emulator` sets this itself while Firebase Emulator Suite sets
# the emulator host variables. Do not point these at the production project.
# LGS_TEST_MODE=emulator
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Production only: JSON mapping from fixed roster IDs to approved Google emails.
# ROSTER_EMAILS={"dan":"dan@example.com","james":"james@example.com"}
